{
  "format_on_save": "on",
  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.fixAll.prettier": true
      },
      "formatter": [
        "prettier"
      ]
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.fixAll.prettier": true
      },
      "formatter": [
        "prettier"
      ]
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.fixAll.prettier": true
      },
      "formatter": [
        "prettier"
      ]
    }
  },
  "prettier": {
    "allowed": true
  }
}
